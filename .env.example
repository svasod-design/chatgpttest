# Binance environment
BINANCE_TRADING_MODE=testnet
BINANCE_ENABLE_LIVE_TRADING=false
BINANCE_REST_BASE_URL=https://testnet.binance.vision
BINANCE_WS_API_URL=wss://ws-api.testnet.binance.vision/ws-api/v3

# Never commit real credentials. Use testnet or read-only keys during development.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading safety defaults
TRADING_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT
MAX_ORDER_NOTIONAL_USDT=25
MAX_DAILY_NOTIONAL_USDT=100
MAX_POSITION_NOTIONAL_USDT=100
MAX_DRAWDOWN_PCT=2
MARKET_DATA_STALE_AFTER_MS=5000

# Application settings
LOG_LEVEL=info
DATABASE_URL=sqlite:///data/quant.db
